# Copy this file to .env and fill in the keys you plan to use.
# Nothing here is required to explore the code, but each stage will
# raise a clear error telling you which key it needs when you run it.

# ---- Stage 2: Research + Script Generation ----
# Choose one provider: anthropic | openai | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Stage 3: Narration (Text-to-Speech) ----
# pyttsx3 = free, fully offline, robotic quality (good for testing)
# elevenlabs = paid, natural quality
TTS_PROVIDER=pyttsx3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Whisper model size for transcription/word-timestamps: tiny/base/small/medium/large-v3
WHISPER_MODEL_SIZE=base

# ---- Stage 4: Footage sourcing (LEGAL SOURCES ONLY) ----
# Free API keys, get them at:
# Pexels:  https://www.pexels.com/api/
# Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional: only used to filter YouTube search results to
# Creative-Commons-licensed videos (videoLicense=creativeCommon).
# Get one at https://console.cloud.google.com/apis (enable YouTube Data API v3)
YOUTUBE_API_KEY=

# ---- Output settings ----
OUTPUT_ASPECT_RATIO=9:16
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai
